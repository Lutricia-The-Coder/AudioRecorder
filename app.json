{
  "expo": {
    "name": "MyVoiceNotes",
    "slug": "my-voice-notes",
    "version": "1.0.0",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow My Voice Notes to use your microphone."
        }
      ]
    ],
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.lutricia.myvoicenotes"
    },
    "extra": {
      "eas": {
        "projectId": "451e23b0-06ed-474c-8117-c3c57f4b42ab"
      }
    }
  }
}
